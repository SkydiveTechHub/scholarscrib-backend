{
  "include": [
    "./**/*.py"
  ],

  "exclude": [
    "dump*",
    ".venv/",
    "**/migrations/",
    "**/tests/",
    "sample_admin/",
  ],

  "ignore": [
  ],

  "defineConstant": {
    "DEBUG": true
  },

//   "stubPath": "src/stubs",

  "reportMissingImports": "error",
  "reportMissingTypeStubs": false,
  "reportIncompatibleMethodOverride": "warning",
  "reportIncompatibleVariableOverride": "warning",

  "pythonVersion": "3.12",
  "pythonPlatform": "All",
  // "pythonPath": "./.venv/bin/python",
  "venvPath": ".",
  "venv": ".venv",

