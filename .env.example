DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scholarscrib
AUTH_SECRET=change-me-student-secret
ADMIN_AUTH_SECRET=change-me-admin-secret-different
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Leave unset to disable the integration.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
PAYSTACK_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SDASH_ACCESS_TOKEN=
# ALOC or SDASH
QUESTION_PROVIDER=ALOC
ALOC_API_KEY=
ALOC_BASE_URL=https://dev.aloc.com.ng/api/v1
# Each explanation costs 10 Aloc credits and is re-billed on every call.
ALOC_FETCH_EXPLANATIONS=false
QUESTION_PROVIDER_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Push (generate once with: npx web-push generate-vapid-keys)
# API reads VAPID_PUBLIC_KEY (also accepts NEXT_PUBLIC_VAPID_PUBLIC_KEY as alias).
# The Next app needs NEXT_PUBLIC_VAPID_PUBLIC_KEY with the same public key value.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@scholarscrib.com
CRON_SECRET=

# AI tutor / RAG (provider-agnostic). Set AI_TUTOR_ENABLED=true when ready.
# LLM_MODEL / EMBEDDING_MODEL use provider:model strings, e.g. openai:gpt-4.1-mini
AI_TUTOR_ENABLED=false
LLM_MODEL=openai:gpt-4.1-mini
# Optional cheaper model for document grading / query rewrite
LLM_GRADER_MODEL=
EMBEDDING_MODEL=openai:text-embedding-3-small
# Optional legacy reranker when Jev is off: flashrank:<model> or cohere:<model>
# When TYPESAFE_API_KEY is set, RAG rerank uses Jev Noul scores (grade reuse).
# e.g. flashrank:ms-marco-MiniLM-L-12-v2  or  cohere:rerank-english-v3.0
RERANKER_MODEL=
ZILLIZ_URI=
ZILLIZ_TOKEN=
MILVUS_COLLECTION=scholarscrib_rag
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scholarscrib-tutor
# TypeSafe Jev (intent / doc grade / rerank / groundedness / remember)
TYPESAFE_API_KEY=
# Optional override (LangSmith gateway or compatible endpoint)
TYPESAFE_BASE_URL=
JEV_MODEL=jev-latest
JEV_ENABLED=true
JEV_CONFIDENCE_THRESHOLD=0.7
JEV_GRADE_NOUL_THRESHOLD=0.55
AI_TUTOR_DAILY_MESSAGE_LIMIT=50
RAG_SUMMARIZE_AFTER_MESSAGES=12
RAG_KEEP_RECENT_MESSAGES=6
